# --- AI provider -------------------------------------------------------
AI_PROVIDER=ollama            # ollama | openai
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_BASE_URL=http://localhost:11434
# OpenAI-compatible chat API (OpenAI, Groq, ...). On Groq use e.g.
# OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=              # only needed if AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings (Phase 5 RAG) ----------------------------------------------
EMBEDDING_PROVIDER=ollama          # ollama | openai
EMBEDDING_MODEL=nomic-embed-text   # Ollama embedding model for the RAG pipeline
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# NOTE: Groq is chat-only — it has no embeddings endpoint. With
# EMBEDDING_PROVIDER=openai pointed at Groq, knowledge-base ingest answers
# 503 gracefully. Point OPENAI_BASE_URL at OpenAI's endpoint (or keep local
# Ollama embeddings) to enable ingest.
DATABASE_URL=postgresql://techmigration:techmigration@localhost:5432/techmigration
QDRANT_URL=http://localhost:6333

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000   # full URL, or bare host (https:// added)
FRONTEND_URL=                                # comma-separated extra CORS origins for the backend
